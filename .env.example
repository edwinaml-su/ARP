# ============================================================
# AVANTE REPORTS PLATFORM - VARIABLES DE ENTORNO
# Copia este archivo a .env.local (dev) y configura las mismas
# variables en Vercel (Project Settings -> Environment Variables).
# ============================================================

# --- Supabase API (publicas, ya rellenadas con el proyecto ARP) ---
NEXT_PUBLIC_SUPABASE_URL="https://dmacokzcfpjpoqxksoyw.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_olSBRzJkp1Y97tLC41rBng_r5U6i5nm"

# --- Supabase service_role (SECRETA, solo servidor) ---
# Necesaria para que /users pueda crear usuarios y cambiar contrasenas de otros.
# Dashboard de Supabase -> Project Settings -> API -> service_role (Reveal).
# NUNCA la expongas al cliente ni la subas al repo. Configurala en Vercel.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Conexion a la base de datos para Prisma ---
# Copia las cadenas EXACTAS desde el dashboard de Supabase:
#   Project Settings -> Database -> Connection string
#   - DATABASE_URL  = "Transaction pooler" (puerto 6543) -> ideal para serverless/Vercel
#   - DIRECT_URL    = "Direct connection"  (puerto 5432) -> usado por migraciones
# Reemplaza [YOUR-DB-PASSWORD] por la contrasena de la base (Settings -> Database -> Reset password).
DATABASE_URL="postgresql://postgres.dmacokzcfpjpoqxksoyw:[YOUR-DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.dmacokzcfpjpoqxksoyw.supabase.co:5432/postgres"

# --- Worker externo (opcional) ---
# Si tienes un worker (Airflow / Cloud Function) que ejecuta los scripts reales,
# pon aqui su URL. "Ejecutar ahora" hara POST a este endpoint ademas de registrar la corrida.
# Dejalo vacio para solo registrar la ejecucion sin disparar nada externo.
WORKER_WEBHOOK_URL=""
WORKER_WEBHOOK_TOKEN=""
